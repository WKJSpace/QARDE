      "rangeLength": 0,
      "text": "// Galois field order (GF(64))\n#ifndef GF_Q\n#define GF_Q\t\t\t\t\t64               \t// Actual GF(q) used\n#endif\n\n#ifndef GF_FACTOR\n#define GF_FACTOR\t\t\t\t64               \t// Actual GF(q) used\n#endif\n\n// Order of GF 2^M = Q\n#ifndef GF_ORDER\n#define M\t\t\t\t\t\t6\t\t\t\t\t// Order of GF\n#endif\n\n// Tanner g5raph size: N = 32, M = 16, E = 96\n#ifndef LDPC_N\n#define LDPC_N\t\t\t\t\t1440              \t// Actual number of columns (variable nodes)\n#endif\n\n#ifndef LDPC_M\n#define LDPC_M\t\t\t\t\t960              \t// Actual number of rows (check nodes)\n#endif\n\n#ifndef DEG_C\n#define DEG_C\t\t\t\t\t3\t\t\t\t\t// Row degree (check node)\n#endif\n\n#ifndef LDPC_E\n#define LDPC_E\t\t\t\t\t(LDPC_M * DEG_C)   \t// total edges for regular (DEG_C, DEG_V)\n#endif\n\n// Degrees (regular (2,12) code)\n#ifndef DEG_V\n#define DEG_V\t\t\t\t\t2\t\t\t\t\t// Column degree (variable node)\n//(LDPC_E / LDPC_N)\n#endif\n\n// EMS truncation parameters\n#ifndef EMS_NM\n#define EMS_NM\t\t\t\t\t16\t\t\t\t\t// Actual Top-M\n#endif\n\n#ifndef NB_FACTOR\n#define NB_FACTOR\t\t\t\t16\t\t\t        // Parallel NM\n#endif\n\n#ifndef EMS_NC\n#define EMS_NC\t\t\t\t\t16\t\t\t\t\t// C (state pruning after convolutions)\n#endif\n\n#ifndef FIX_MIN\n#define FIX_MIN\t\t\t\t\t(a,b) ((a) < (b) ? (a) : (b))\n#endif\n\n#ifndef BUBBLE_HALF\n#define BUBBLE_HALF\t\t\t\t2\t\t\t\t\t// half size of bubble\n#endif\n\n#ifndef BUBBLE\n#define BUBBLE\t\t\t\t\t2 * BUBBLE_HALF\t\t// bubble\n#endif\n\n#ifndef NBOPER\n#define NBOPER\t\t\t\t25\n#endif\n",
      "rangeOffset": 1338,
      "forceMoveMarkers": false
    }
  ],
